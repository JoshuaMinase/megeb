{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://megeb-backend.onrender.com/api/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "https://megeb-backend.onrender.com/auth/$1"
    },
    {
      "src": "/health",
      "dest": "https://megeb-backend.onrender.com/health"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
