{
  "version": 2,
  "buildCommand": "echo 'No build required'",
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://megeb-backend.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://megeb-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://megeb-backend.onrender.com/ai/:path*"
    },
    {
      "source": "/pantry/:path*",
      "destination": "https://megeb-backend.onrender.com/pantry/:path*"
    },
    {
      "source": "/meal-plan/:path*",
      "destination": "https://megeb-backend.onrender.com/meal-plan/:path*"
    },
    {
      "source": "/nutrition/:path*",
      "destination": "https://megeb-backend.onrender.com/nutrition/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://megeb-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://megeb-backend.onrender.com/health"
    }
  ]
}
